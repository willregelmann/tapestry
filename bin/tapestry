#!/usr/bin/env bash
# Launcher for the tapestry Claude Code plugin: every hook, the MCP server and the CLI start here.
#
# The Python runtime lives in the plugin's data directory, which survives plugin updates, and is
# rebuilt from the plugin's own source when that changes. A SessionStart hook starts the rebuild,
# detached, so nothing waits on it and nobody runs an install command. Until it finishes, hooks say
# memory is setting up rather than failing silently.
#
#   bin/tapestry install   build the runtime now (the hooks do this by themselves)
#   bin/tapestry ...       run the tapestry CLI
#
# TAPESTRY_PYTHON runs a development checkout's interpreter and skips all of this.
# TAPESTRY_INSTALLER replaces the program that does the install (tests).
set -euo pipefail
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
HOME_DIR="${TAPESTRY_HOME:-$HOME/.tapestry}"   # minds and the model: the user's, kept if the plugin goes
DATA="${CLAUDE_PLUGIN_DATA:-$HOME_DIR}"        # the runtime: rebuilt from the plugin, removed with it
BUILT="$DATA/built-from"                       # names the runtime that is ready; written last
# Each build gets its own directory and is used only once BUILT names it, so a build in progress,
# or one that failed, is never run and an update never changes a runtime that is serving.
if [ -n "${TAPESTRY_PYTHON:-}" ]; then
  PY="$TAPESTRY_PYTHON"
elif [ -s "$BUILT" ]; then
  PY="$DATA/runtime-$(cat "$BUILT")/bin/python"
else
  PY="$DATA/no-runtime-yet"
fi
LOCK="$DATA/install.lock"
LOG="$DATA/logs/install.log"
STALE_MINUTES=30

# A fingerprint of what the runtime is built from, so a changed plugin rebuilds it.
source_hash() {
  python3 - "$ROOT" <<'PY'
import hashlib, pathlib, sys
root = pathlib.Path(sys.argv[1])
h = hashlib.sha256()
for p in [root / "pyproject.toml", *sorted((root / "src").rglob("*.py"))]:
    h.update(p.relative_to(root).as_posix().encode())
    h.update(p.read_bytes())
print(h.hexdigest()[:16])
PY
}

if [ "${1:-}" = "source-hash" ]; then
  source_hash
  exit 0
fi

if [ "${1:-}" = "install" ]; then
  mkdir -p "$DATA/logs"
  if ! mkdir "$LOCK" 2>/dev/null; then
    if find "$LOCK" -maxdepth 0 -mmin "+$STALE_MINUTES" | grep -q .; then
      rmdir "$LOCK" 2>/dev/null || true
      mkdir "$LOCK" 2>/dev/null || exit 0
    else
      echo "another install is already running" >&2
      exit 0
    fi
  fi
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
  want="$(source_hash)"
  new="$DATA/runtime-$want"
  echo "$(date '+%F %T') building the runtime from $ROOT ($want)"
  rm -rf "$new"
  python3 -m venv "$new"
  "$new/bin/pip" install --quiet "$ROOT"
  "$new/bin/python" -m tapestry.cli setup
  echo "$want" > "$BUILT.new"
  mv "$BUILT.new" "$BUILT"
  for old in "$DATA"/runtime-*; do [ "$old" = "$new" ] || rm -rf "$old"; done
  echo "$(date '+%F %T') ready"
  exit 0
fi

# Start the install in the background, unless one is already going.
spawn_install() {
  if [ -d "$LOCK" ] && ! find "$LOCK" -maxdepth 0 -mmin "+$STALE_MINUTES" | grep -q .; then
    return 0
  fi
  mkdir -p "$DATA/logs"
  python3 - "${TAPESTRY_INSTALLER:-$ROOT/bin/tapestry}" "$LOG" <<'PY'
import subprocess, sys
with open(sys.argv[2], "a") as log:
    subprocess.Popen([sys.argv[1], "install"], stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                     start_new_session=True)
PY
}

event="" input=""
if [ "${1:-}" = "hook" ]; then
  input="$(cat)"
  event="$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("hook_event_name",""))' 2>/dev/null || true)"
fi

if [ -z "${TAPESTRY_PYTHON:-}" ]; then
  case "$event" in
    SessionStart|UserPromptSubmit)
      if [ ! -x "$PY" ]; then
        spawn_install
      elif [ "$event" = "SessionStart" ] && [ "$(cat "$BUILT" 2>/dev/null || true)" != "$(source_hash)" ]; then
        spawn_install       # an update: keep using what's there until the rebuild is done
      fi ;;
  esac
fi

if [ ! -x "$PY" ]; then
  msg="[MEMORY UNAVAILABLE: tapestry is setting itself up (first run, or after an update). This takes a few minutes. Start a new session, or run /reload-plugins, once it is done. Progress: $LOG. No memories were searched.]"
  if [ "${1:-}" = "hook" ]; then
    case "$event" in
      SessionStart|UserPromptSubmit)
        python3 -c 'import json,sys; print(json.dumps({"hookSpecificOutput": {"hookEventName": sys.argv[1], "additionalContext": sys.argv[2]}}))' "$event" "$msg" ;;
    esac
    exit 0
  fi
  echo "$msg" >&2
  exit 1
fi

if [ "${1:-}" = "hook" ]; then
  printf '%s' "$input" | "$PY" -m tapestry.cli "$@"
  exit
fi
exec "$PY" -m tapestry.cli "$@"
