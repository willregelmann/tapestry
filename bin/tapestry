#!/usr/bin/env bash
# Launcher for the tapestry Claude Code plugin.
#   bin/tapestry install   create ~/.tapestry/venv, install tapestry, fetch the model
#   bin/tapestry ...       run the tapestry CLI (hooks and the MCP server call this)
# TAPESTRY_PYTHON overrides the interpreter, e.g. a development checkout's venv.
set -euo pipefail
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
VENV="${TAPESTRY_HOME:-$HOME/.tapestry}/venv"
PY="${TAPESTRY_PYTHON:-$VENV/bin/python}"

if [ "${1:-}" = "install" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install --quiet --upgrade pip
  "$VENV/bin/pip" install --quiet "$ROOT"
  exec "$VENV/bin/python" -m tapestry.cli setup
fi

if [ ! -x "$PY" ]; then
  msg="[MEMORY UNAVAILABLE: tapestry isn't installed. Run: ${ROOT}/bin/tapestry install. No memories were searched.]"
  if [ "${1:-}" = "hook" ]; then
    event=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("hook_event_name",""))' 2>/dev/null || true)
    case "$event" in
      SessionStart|UserPromptSubmit)
        python3 -c 'import json,sys; print(json.dumps({"hookSpecificOutput": {"hookEventName": sys.argv[1], "additionalContext": sys.argv[2]}}))' "$event" "$msg" ;;
    esac
    exit 0
  fi
  echo "$msg" >&2
  exit 1
fi
exec "$PY" -m tapestry.cli "$@"
